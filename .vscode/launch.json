{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rb87 00 - 运行入门示例",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_demo.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "OPENBLAS_NUM_THREADS": "1",
        "OMP_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1",
        "MPLBACKEND": "Agg"
      },
      "args": []
    },
    {
      "name": "Rb87 01 - 快速重放已制备原子",
      "type": "debugpy",
      "request": "launch",
      "module": "rb87_beam",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "OPENBLAS_NUM_THREADS": "1",
        "OMP_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1",
        "MPLBACKEND": "Agg"
      },
      "args": [
        "--config",
        "beam_outputs/raman_power_calibration/config_power_driven.json",
        "--source-state-h5",
        "beam_outputs/endpoint_comparison/native_validation/baseline/nominal/prepared_0.h5",
        "--no-optical-pumping",
        "--no-noise",
        "--output",
        "outputs/vscode/phase"
      ]
    },
