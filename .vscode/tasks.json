{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rb87: 运行入门示例",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "run_demo.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Rb87: 运行全部单元测试",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "OPENBLAS_NUM_THREADS": "1",
          "OMP_NUM_THREADS": "1",
          "MKL_NUM_THREADS": "1"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
